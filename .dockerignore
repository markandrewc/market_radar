# Nicht mit ins Image kopieren – hält den Build klein und reproduzierbar.
node_modules
dist
.git
.gitignore
.npm-cache
.tools
npm-debug.log*
.DS_Store

# Python-Backend: venv, Caches, lokale Postgres-Daten, Tests
backend/.venv
backend/data
backend/tests
backend/.pytest_cache
backend/dev_db.py
**/__pycache__
**/*.pyc
**/*.db
**/*.db-wal
**/*.db-shm

# Env-Dateien bleiben draußen (Railway-Variablen kommen zur Laufzeit).
# So landen keine lokalen Secrets im Image.
.env
.env.*
