# --- Frontend (Vite) ----------------------------------------------------------
# Vite backt VITE_*-Variablen beim Build in das Bundle. Änderungen erfordern
# also ein neues Deployment (kein Runtime-Env).
#
# "1" (oder nicht gesetzt) = Mock-Daten + Banner "Demo data".
# "0" = Demand und Skills kommen vom Backend (/api), Banner aus.
#       Seiten ohne Backend-Endpunkt zeigen weiterhin Mock-Daten.
VITE_USE_MOCKS=1

# Nur lokal relevant: der Dev-Server proxyt /api/ auf diese Adresse
# (siehe vite.config.ts). In Produktion ist das Backend ein eigenes
# Railway-Service, angesprochen über private Networking.
# API_ORIGIN=http://localhost:8787

# --- Backend (FastAPI) --------------------------------------------------------
# Postgres connection (Railway sets this when you add a Postgres service).
# Locally: `uv run python backend/dev_db.py` prints one.
DATABASE_URL=postgresql://user:password@localhost:5432/market_radar
# Days without new data before a source shows as "Out of date"
SOURCE_STALE_DAYS=7
# Shared secret for DELETE /api/sources/{id}; empty = disabled
INGEST_TOKEN=change-me

# --- Pipeline ---------------------------------------------------------------
# Raw folder: step 1 (npm run ingest) writes originals + latest.json, step 2 (npm run normalize) reads them.
# MARKET_RADAR_RAW_DIR=.market-radar/raw

# --- Connector sources (docs/ADDING_SOURCES.md) ------------------------------
# Path to the declarative source list. On Railway point this at the volume, e.g.
# /data/sources.yaml: a missing file is seeded from the image copy on first start.
# SOURCES_FILE=/data/sources.yaml
# API keys used by ${...} placeholders in sources.yaml; missing keys skip that source.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- Level 2: e-mailed briefings (docs/REPORTS.md) ---------------------------
# One provider per deployment: brevo (HTTP API), smtp (any relay, e.g. Brevo's
# SMTP relay) or resend. Leave MAIL_PROVIDER empty to auto-detect from the keys
# below (brevo -> resend -> smtp). With no credentials every send is recorded as
# a dry run and the in-app preview still works.
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=1
# Verified sender, e.g. "Market Radar <radar@your-domain.ch>" (Brevo: a verified
# sender address in your Brevo account; Resend: a verified domain, otherwise it
# only delivers to the account owner's address).
# REPORT_FROM=Market Radar <radar@your-domain.ch>
# REPORT_REPLY_TO=
# Absolute links in the e-mail (unsubscribe, "open dashboard"), e.g. https://radar.example.ch
# PUBLIC_BASE_URL=
# Week/month boundaries are compared in this time zone.
# REPORT_TIMEZONE=Europe/Zurich
# Safety valve for the public subscribe endpoint.
# REPORTS_DAILY_CAP=100
# Optional LLM polish of the wording only (citations are always appended by the code).
# LLM_BASE_URL=  LLM_API_KEY=  LLM_MODEL=

# --- LLM explanations (docs/LLM.md) -----------------------------------------
# OpenAI-compatible provider preset: deepseek | openai | custom.
# LLM_BASE_URL / LLM_MODEL override the preset. Without LLM_API_KEY the
# explanations are disabled and the deterministic reading is shown instead.
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=
# LLM_TIMEOUT=20
# LLM_MAX_OUTPUT_TOKENS=700
# LLM_DAILY_TOKEN_CAP=200000
# LLM_RATE_PER_MIN=6
# LLM_RATE_PER_DAY=100
# LLM_LANGUAGE=en
