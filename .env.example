# --- Frontend (Vite) ----------------------------------------------------------
# Vite backt VITE_*-Variablen beim Build in das Bundle. Änderungen erfordern
# also ein neues Deployment (kein Runtime-Env).
#
# "1" (oder nicht gesetzt) = Mock-Daten + Banner "Demo data".
# "0" = Demand und Skills kommen vom Backend (/api), Banner aus.
#       Seiten ohne Backend-Endpunkt zeigen weiterhin Mock-Daten.
VITE_USE_MOCKS=1

# Nur lokal relevant: der Dev-Server proxyt /api/ auf diese Adresse
# (siehe vite.config.ts). In Produktion ist das Backend ein eigenes
# Railway-Service, angesprochen über private Networking.
# API_ORIGIN=http://localhost:8787

# --- Backend (FastAPI) --------------------------------------------------------
# Postgres connection (Railway sets this when you add a Postgres service).
# Locally: `uv run python backend/dev_db.py` prints one.
DATABASE_URL=postgresql://user:password@localhost:5432/market_radar
# Days without new data before a source shows as "Out of date"
SOURCE_STALE_DAYS=7
# Shared secret for DELETE /api/sources/{id}; empty = disabled
INGEST_TOKEN=change-me

# --- Pipeline ---------------------------------------------------------------
# Raw folder: step 1 (npm run ingest) writes originals + latest.json, step 2 (npm run normalize) reads them.
# MARKET_RADAR_RAW_DIR=.market-radar/raw

# --- Connector sources (docs/ADDING_SOURCES.md) ------------------------------
# Path to the declarative source list. On Railway point this at the volume, e.g.
# /data/sources.yaml: a missing file is seeded from the image copy on first start.
# SOURCES_FILE=/data/sources.yaml
# API keys used by ${...} placeholders in sources.yaml; missing keys skip that source.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
